# dev | staging | prod
TEST_ENV=dev
# Shared password of the seed accounts (taken from GitHub Secrets in CI)
TEST_PASSWORD=change-me
# Optional: command that refills the Bidium test database.
# Runs once before the whole run, and with "--lot <id>" before every bid test.
SEED_COMMAND=node scripts/seed.js
# Database used by the seed (the same one the running app uses). Locally: docker compose up -d
DATABASE_URL=mongodb://localhost:27018/bidium_e2e?replicaSet=rs0&directConnection=true
